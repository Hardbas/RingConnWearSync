<?xml version="1.0" encoding="utf-8"?>
<!--
    Celestial crescent for the sleep tile.

    WHY THIS IS A SINGLE CLOSED PATH AND NOT TWO CIRCLES:
    evenOdd subtraction of two offset circles fills BOTH slivers — the right one AND the
    left one — so the result is a ring with a dark hole, not a crescent. That is what the
    previous revision produced, and it read as a border around the score.
    A crescent must be ONE closed outline: the outer arc out, the inner arc back.

    Coordinate space: 192dp with a 1:1 viewport, laid out with expand(), so one viewport
    unit equals one tile dp. Position is therefore literal.

    Placement: the moon's disc sits at (134,46) r=32, upper-right, clear of the vertical
    column holding the title, the score, the quality label, the duration and the capsule.

    Never tinted: any ColorFilter.setTint collapses the gradients below into one flat
    colour and this file becomes a blob.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- Lunar bloom -->
    <path android:pathData="M82,64 A42,42 0 1,0 166,64 A42,42 0 1,0 82,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="124"
                android:centerY="64"
                android:gradientRadius="42">
                <item android:offset="0.00" android:color="#30FFFFFF" />
                <item android:offset="0.34" android:color="#18DCE6FF" />
                <item android:offset="0.64" android:color="#0E9B8EE0" />
                <item android:offset="1.00" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Earthshine: the unlit disc, very faint, weighted toward the lit limb -->
    <path android:pathData="M92,64 A32,32 0 1,0 156,64 A32,32 0 1,0 92,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="132"
                android:centerY="58"
                android:gradientRadius="40">
                <item android:offset="0.00" android:color="#12C9D8FF" />
                <item android:offset="0.45" android:color="#0C9FB2E8" />
                <item android:offset="0.82" android:color="#00000000" />
                <item android:offset="1.00" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
        The lit crescent. Proven outline from the original drawable (outer arc out,
        inner arc back = one closed shape), rescaled and moved into the corner with a
        group transform so the path data itself stays known-good.
        Original space: outer circle centre (60,60) r=52; body spans x 89..112.
    -->
    <group
        android:pivotX="86"
        android:pivotY="60"
        android:scaleX="0.62"
        android:scaleY="0.62"
        android:translateX="54"
        android:translateY="4">
        <path android:pathData="M60,8 C88.7,8 112,31.3 112,60 C112,88.7 88.7,112 60,112 C78,98 89,76 89,60 C89,44 78,22 60,8 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="112"
                    android:startY="20"
                    android:endX="89"
                    android:endY="100">
                    <item android:offset="0.00" android:color="#FFFFFFFF" />
                    <item android:offset="0.52" android:color="#FFFFF8E6" />
                    <item android:offset="1.00" android:color="#FFE7C98E" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

</vector>
