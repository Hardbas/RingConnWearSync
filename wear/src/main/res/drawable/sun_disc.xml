<?xml version="1.0" encoding="utf-8"?>
<!--
    Setting sun for the sleep tile entrance.

    A radial gradient that reaches full transparency at the rim, so the disc has no
    hard edge: as it translates down and gets occluded by the horizon, the eye reads
    a glowing body sinking, not a circle being slid away.

    Never tinted. A ColorFilter.setTint would replace the four warm stops with one
    flat colour and kill the falloff.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="70dp"
    android:height="70dp"
    android:viewportWidth="70"
    android:viewportHeight="70">

    <path android:pathData="M0,35 A35,35 0 1,0 70,35 A35,35 0 1,0 0,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="35"
                android:centerY="33"
                android:gradientRadius="35">
                <item android:offset="0.00" android:color="#FFFFF7D6" />
                <item android:offset="0.15" android:color="#FFFFE69A" />
                <item android:offset="0.36" android:color="#FFFFC24A" />
                <item android:offset="0.60" android:color="#FFFF9236" />
                <item android:offset="0.82" android:color="#52FF6E28" />
                <item android:offset="1.00" android:color="#00FF5A1E" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
