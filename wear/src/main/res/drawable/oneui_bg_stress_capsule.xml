<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="190dp"
    android:height="136dp"
    android:viewportWidth="190"
    android:viewportHeight="136">

    <!-- Stadium Capsule Base Fill & Luminous Rim -->
    <path
        android:pathData="M68,1 L122,1 A67,67 0 0,1 189,68 A67,67 0 0,1 122,135 L68,135 A67,67 0 0,1 1,68 A67,67 0 0,1 68,1 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#508C7CFF">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="190"
                android:endY="136"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF241C38" />
                <item android:offset="0.5" android:color="#FF151022" />
                <item android:offset="1.0" android:color="#FF0C0914" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Radial Glow Accent behind right-side tachometer gauge -->
    <path
        android:pathData="M142,24 A44,44 0 1,1 141.9,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="142"
                android:centerY="68"
                android:gradientRadius="44"
                android:type="radial">
                <item android:offset="0.0" android:color="#357C4DFF" />
                <item android:offset="0.6" android:color="#125333AA" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
