<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="206dp"
    android:height="146dp"
    android:viewportWidth="206"
    android:viewportHeight="146">

    <!-- Stadium Capsule Base Fill & Luminous Lilac Rim (206dp x 146dp) -->
    <path
        android:pathData="M 73,1 L 133,1 A 72,72 0 0,1 205,73 A 72,72 0 0,1 133,145 L 73,145 A 72,72 0 0,1 1,73 A 72,72 0 0,1 73,1 Z"
        android:strokeWidth="1.8"
        android:strokeColor="#FFC4B5FD">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="206"
                android:endY="146"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF543F74" />
                <item android:offset="0.4" android:color="#FF382750" />
                <item android:offset="1.0" android:color="#FF1E142E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ambient Radial Lilac Glow Accent behind right-side tachometer gauge -->
    <path
        android:pathData="M 152,25 A 48,48 0 1,1 151.9,25 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="152"
                android:centerY="73"
                android:gradientRadius="48"
                android:type="radial">
                <item android:offset="0.0" android:color="#45D8B4FE" />
                <item android:offset="0.6" android:color="#1CA855F7" />
                <item android:offset="1.0" android:color="#00000000" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
