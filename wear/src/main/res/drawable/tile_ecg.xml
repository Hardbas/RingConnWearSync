<?xml version="1.0" encoding="utf-8"?>
<!--
    The cardiogram the pulse tile scrolls behind the dial.

    The design renders it as a stroked line under a CSS mask that fades both
    sides. ProtoLayout has no masks, so the stroke used to be cut dead at the
    bezel and the loop read as a GIF restart. The mask is now baked in: this is a
    FILLED area between the trace and the baseline, and each 192dp period carries
    its own horizontal alpha gradient that reaches zero at both ends.

    Consequences that matter:
      - nothing is ever sliced at the tile edge, the trace simply arrives and
        leaves through the gradient;
      - the fade pattern repeats exactly every 192dp, which is the scroll travel,
        so the restart of the animation is pixel-identical and invisible;
      - white is deliberate: the tile tints it with TileAccents.heartRateLabel, so
        the palette never leaks into a drawable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="384dp"
    android:height="192dp"
    android:viewportWidth="384"
    android:viewportHeight="192">

    <path
        android:pathData="M0,132 L0,100 H34 l5,-5 l5,5 H66 l4,8 l6,-40 l6,50 l4,-18 H98 l7,-6 l8,6 H192 L192,132 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="192"
                android:endY="0">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.18" android:color="#B8FFFFFF" />
                <item android:offset="0.82" android:color="#B8FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <group android:translateX="192">
        <path
            android:pathData="M0,132 L0,100 H34 l5,-5 l5,5 H66 l4,8 l6,-40 l6,50 l4,-18 H98 l7,-6 l8,6 H192 L192,132 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="0"
                    android:endX="192"
                    android:endY="0">
                    <item android:offset="0.0" android:color="#00FFFFFF" />
                    <item android:offset="0.18" android:color="#B8FFFFFF" />
                    <item android:offset="0.82" android:color="#B8FFFFFF" />
                    <item android:offset="1.0" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
