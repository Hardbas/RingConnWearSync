<?xml version="1.0" encoding="utf-8"?>
<!--
    The shooting star of the sleep tile: the design's `.sh` layer, one streak
    crossing the upper face every cycle. Drawn white and tinted with the sleep
    label accent; the head is bright and the tail fades, which is what reads as
    motion once the image is translated.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="40dp"
    android:viewportWidth="64"
    android:viewportHeight="40">
    <path
        android:pathData="M4,32 L44,10"
        android:strokeWidth="1.6"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="4"
                android:startY="32"
                android:endX="44"
                android:endY="10">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.75" android:color="#AAFFFFFF" />
                <item android:offset="1.0" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M44,10 a2.2,2.2 0 1,0 0.1,0"
        android:fillColor="#FFFFFFFF" />
</vector>
