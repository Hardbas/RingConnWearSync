<?xml version="1.0" encoding="utf-8"?>
<!--
    The warm halo behind the dial, drawn by the design as
    `radial-gradient(circle, accent 0%, transparent 70%)` on a 156dp inset face.

    ProtoLayout 1.3.0 has no radial brush (only LinearGradient and SweepGradient),
    so the gradient lives in a drawable and is tinted with the metric accent at
    the call site. White here means "take the tint colour": the alpha ramp below
    is the only thing this file contributes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="156dp"
    android:height="156dp"
    android:viewportWidth="156"
    android:viewportHeight="156">

    <path android:pathData="M78,0 A78,78 0 1,1 78,156 A78,78 0 1,1 78,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="78"
                android:centerY="78"
                android:gradientRadius="78">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.42" android:color="#8CFFFFFF" />
                <item android:offset="0.7" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
