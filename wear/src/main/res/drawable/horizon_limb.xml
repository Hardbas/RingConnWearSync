<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizon limb for the sunset entrance.

    Three layers, in this order:
      1. A warm band ABOVE the curve, fading to transparent upwards. This is the light
         the sun leaves behind on the atmosphere; without it the curve reads as a
         black cut-out instead of a horizon.
      2. The opaque silhouette BELOW the curve. This is what occludes the sun as it
         sinks, so no clipping mask is needed: the horizon is simply drawn after it.
      3. A thin warm rim exactly on the curve.

    The curve sits at y=168 of a 192 viewport. It was at 152, which left the sun only
    ~500ms of visible life out of a 1700ms descent; at 168 the sun is fully visible for
    roughly the first half of the travel and only then sinks behind the limb.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="192dp"
    android:height="192dp"
    android:viewportWidth="192"
    android:viewportHeight="192">

    <!-- 1. Atmospheric glow leaking above the limb -->
    <path android:pathData="M-12,168 Q96,138 204,168 L204,140 Q96,110 -12,140 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="112"
                android:endX="0"
                android:endY="168">
                <item android:offset="0.00" android:color="#00FF9A55" />
                <item android:offset="0.55" android:color="#26FFA860" />
                <item android:offset="1.00" android:color="#66FFC98A" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Opaque silhouette: this is the occluder -->
    <path
        android:pathData="M-12,168 Q96,138 204,168 L204,196 L-12,196 Z"
        android:fillColor="#FF06060B" />

    <!-- 3. Warm rim on the limb itself -->
    <path android:pathData="M-12,168 Q96,138 204,168"
        android:strokeWidth="1.6"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="192"
                android:endY="0">
                <item android:offset="0.00" android:color="#00FFB070" />
                <item android:offset="0.50" android:color="#B3FFC98A" />
                <item android:offset="1.00" android:color="#00FFB070" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
